# ──────────────────────────────────────────────
# FraudShield — Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── Database ───────────────────────────────────
# MySQL (default)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/fraud_db

# SQLite (easy local dev — no MySQL needed)
# DATABASE_URL=sqlite:///./fraudshield.db

# ── JWT Security ───────────────────────────────
SECRET_KEY=change-this-to-a-random-32-char-secret-key-NOW
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email / OTP ────────────────────────────────
# Leave blank to print OTPs to console (dev mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# ── Server ─────────────────────────────────────
HOST=0.0.0.0
PORT=8000
